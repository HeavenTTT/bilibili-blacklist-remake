{
  "userscript": {
    "name": "Bilibili-BlackList Remake",
    "namespace": "https://github.com/HeavenTTT/bilibili-blacklist",
    "author": "HeavenTTT",
    "description": "Bilibili-BlackList 完全重写版：观察 B 站视频卡片并提取 标题 / UP 主名字 / bvid。",
    "icon": "https://www.bilibili.com/favicon.ico",
    "match": [
      "*://*.bilibili.com/*"
    ],
    "grant": [
      "GM_setValue",
      "GM_getValue",
      "GM_addStyle"
    ],
    "license": "MIT",
    "noframes": true,
    "runAt": "document-idle"
  },
  "src": {
    "outputDir": "dist",
    "outputBase": "bilibili-blacklist-remake.user.js",
    "modules": [
      "src/config/selectors.js",
      "src/utils/query.js",
      "src/utils/log.js",
      "src/core/cards.js",
      "src/observer/observer.js",
      "src/main.js"
    ]
  }
}
